{
  "name": "qingzhi-ai-advisor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "青智家 AI 顾问 - 面向青岛智慧家电消费场景的智能客服与营销转化平台（演示版）",
  "scripts": {
    "start": "node server.mjs",
